generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  ORG_ADMIN
  SUPPORT_AGENT
  REVIEWER
  CROSS_ORG_GUEST
}

enum OrgConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

enum PrStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  MERGED
}

enum PrReviewDecision {
  APPROVE
  REQUEST_CHANGES
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ShareResourceType {
  TICKET
  PULL_REQUEST
}

enum ShareGrantStatus {
  ACTIVE
  REVOKED
}

enum DigestRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum NotificationType {
  DIGEST
}

enum NotificationChannel {
  IN_APP
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())

  memberships         OrgMembership[]
  auditLogs           AuditLog[]
  pullRequests        PullRequest[]
  tickets             Ticket[]
  ticketComments      TicketComment[]
  ticketAttachments   TicketAttachment[]
  prComments          PrComment[]        @relation("PrCommentOrg")
  prCommentsAuthored  PrComment[]        @relation("PrCommentAuthorOrg")
  shareGrantsOwned    ShareGrant[]       @relation("ShareGrantOwnerOrg")
  shareGrantsReceived ShareGrant[]       @relation("ShareGrantGranteeOrg")
  connectionsAsA      OrgConnection[]    @relation("OrgConnectionOrgA")
  connectionsAsB      OrgConnection[]    @relation("OrgConnectionOrgB")

  @@index([slug])
  @@map("organizations")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())

  memberships               OrgMembership[]
  auditLogs                 AuditLog[]
  sessions                  Session[]
  authoredPullRequests      PullRequest[]      @relation("PullRequestAuthor")
  createdPrVersions         PrVersion[]
  prReviewerAssignments     PrReviewer[]
  prReviewsSubmitted        PrReview[]
  prCommentsAuthored        PrComment[]        @relation("PrCommentAuthor")
  ticketsCreated            Ticket[]           @relation("TicketCreatedBy")
  ticketsAssigned           Ticket[]           @relation("TicketAssignee")
  ticketCommentsAuthored    TicketComment[]    @relation("TicketCommentAuthor")
  ticketAttachmentsUploaded TicketAttachment[] @relation("TicketAttachmentUploader")
  shareGrantsReceived       ShareGrant[]       @relation("ShareGrantGrantedTo")
  shareGrantsGranted        ShareGrant[]       @relation("ShareGrantGrantedBy")
  shareGrantsRevoked        ShareGrant[]       @relation("ShareGrantRevokedBy")
  requestedConnections      OrgConnection[]    @relation("OrgConnectionRequestedBy")
  respondedConnections      OrgConnection[]    @relation("OrgConnectionRespondedBy")
  notifications             Notification[]

  @@map("users")
}

model OrgMembership {
  id         String    @id @default(cuid())
  userId     String
  orgId      String
  role       OrgRole
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@map("org_memberships")
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  org  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([orgId, createdAt])
  @@map("audit_logs")
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  activeOrgId String?
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([activeOrgId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model OrgConnection {
  id            String              @id @default(cuid())
  orgAId        String
  orgBId        String
  status        OrgConnectionStatus @default(PENDING)
  requestedById String
  respondedById String?
  createdAt     DateTime            @default(now())

  orgA        Organization @relation("OrgConnectionOrgA", fields: [orgAId], references: [id], onDelete: Cascade)
  orgB        Organization @relation("OrgConnectionOrgB", fields: [orgBId], references: [id], onDelete: Cascade)
  requestedBy User         @relation("OrgConnectionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  respondedBy User?        @relation("OrgConnectionRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  shareGrants ShareGrant[]

  @@unique([orgAId, orgBId])
  @@index([status])
  @@map("org_connections")
}

model PullRequest {
  id                String   @id @default(cuid())
  orgId             String
  authorId          String
  title             String
  description       String   @default("")
  status            PrStatus @default(DRAFT)
  requiresApprovals Int      @default(1)
  currentVersion    Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author    User         @relation("PullRequestAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  versions  PrVersion[]
  reviewers PrReviewer[]
  reviews   PrReview[]
  comments  PrComment[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([authorId])
  @@map("pull_requests")
}

model PrVersion {
  id            String   @id @default(cuid())
  pullRequestId String
  versionNumber Int
  title         String
  description   String
  createdById   String
  createdAt     DateTime @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  reviews     PrReview[]

  @@unique([pullRequestId, versionNumber])
  @@index([pullRequestId])
  @@map("pr_versions")
}

model PrReviewer {
  id            String @id @default(cuid())
  pullRequestId String
  userId        String

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, userId])
  @@map("pr_reviewers")
}

model PrReview {
  id            String           @id @default(cuid())
  pullRequestId String
  versionId     String
  reviewerId    String
  decision      PrReviewDecision
  comment       String           @default("")
  createdAt     DateTime         @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  version     PrVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([pullRequestId, versionId])
  @@index([reviewerId])
  @@map("pr_reviews")
}

model Ticket {
  id          String       @id @default(cuid())
  orgId       String
  title       String
  description String       @default("")
  status      TicketStatus @default(OPEN)
  createdById String
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignee    User?              @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TicketComment[]
  attachments TicketAttachment[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, updatedAt])
  @@map("tickets")
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  orgId     String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author User         @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([orgId, ticketId])
  @@index([orgId, createdAt])
  @@map("ticket_comments")
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  orgId        String
  uploadedById String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  createdAt    DateTime @default(now())

  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy User         @relation("TicketAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([orgId, ticketId])
  @@map("ticket_attachments")
}

/// Cross-org item share. Partial unique ACTIVE index + CHECK
/// (ownerOrgId <> granteeOrgId AND orgConnectionId IS NOT NULL) live in SQL migration.
model ShareGrant {
  id              String            @id @default(cuid())
  resourceType    ShareResourceType
  resourceId      String
  ownerOrgId      String
  granteeOrgId    String
  grantedToUserId String
  grantedByUserId String
  orgConnectionId String
  status          ShareGrantStatus  @default(ACTIVE)
  revokedAt       DateTime?
  revokedById     String?
  revokeReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  ownerOrg      Organization  @relation("ShareGrantOwnerOrg", fields: [ownerOrgId], references: [id], onDelete: Cascade)
  granteeOrg    Organization  @relation("ShareGrantGranteeOrg", fields: [granteeOrgId], references: [id], onDelete: Cascade)
  grantedToUser User          @relation("ShareGrantGrantedTo", fields: [grantedToUserId], references: [id], onDelete: Cascade)
  grantedByUser User          @relation("ShareGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  orgConnection OrgConnection @relation(fields: [orgConnectionId], references: [id], onDelete: Cascade)
  revokedBy     User?         @relation("ShareGrantRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([grantedToUserId, status])
  @@index([granteeOrgId, status])
  @@index([ownerOrgId, resourceType, status])
  @@index([resourceType, resourceId, status])
  @@index([orgConnectionId, status])
  @@map("share_grants")
}

/// PR comments always tenancy-scoped to pullRequest.orgId (owner).
model PrComment {
  id            String   @id @default(cuid())
  pullRequestId String
  orgId         String
  authorOrgId   String?
  authorId      String
  body          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pullRequest PullRequest   @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  org         Organization  @relation("PrCommentOrg", fields: [orgId], references: [id], onDelete: Cascade)
  authorOrg   Organization? @relation("PrCommentAuthorOrg", fields: [authorOrgId], references: [id], onDelete: SetNull)
  author      User          @relation("PrCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([pullRequestId])
  @@index([orgId, pullRequestId])
  @@map("pr_comments")
}

model DigestRun {
  id                 String          @id @default(cuid())
  scheduledFor       DateTime        @unique
  status             DigestRunStatus @default(RUNNING)
  startedAt          DateTime        @default(now())
  finishedAt         DateTime?
  processedUserCount Int             @default(0)
  notifiedUserCount  Int             @default(0)
  errorMessage       String?
  stats              Json            @default("{}")

  notifications Notification[]

  @@index([status, startedAt])
  @@map("digest_runs")
}

model Notification {
  id          String              @id @default(cuid())
  userId      String
  type        NotificationType    @default(DIGEST)
  channel     NotificationChannel @default(IN_APP)
  title       String
  body        String
  /// Server-only structured facts — never select into API DTOs
  facts       Json                @default("{}")
  /// Resource ids for revoke redaction: ["ticket:cuid", "pr:cuid"]
  resourceIds String[]            @default([])
  redactedAt  DateTime?
  digestRunId String
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  digestRun DigestRun @relation(fields: [digestRunId], references: [id], onDelete: Cascade)

  @@unique([userId, digestRunId, type, channel])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, redactedAt])
  @@map("notifications")
}
