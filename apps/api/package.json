{
  "name": "@unified/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:bola": "vitest run --config vitest.bola.config.ts",
    "digest:once": "tsx src/worker/digest-once.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@prisma/client": "^6.9.0",
    "@unified/db": "workspace:*",
    "@unified/types": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "file-type": "^22.0.1",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.22",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "@unified/config": "workspace:*",
    "eslint": "^9.28.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
