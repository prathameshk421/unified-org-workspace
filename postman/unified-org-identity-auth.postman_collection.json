{
  "info": {
    "name": "Unified Org — Identity Auth",
    "description": "Identity auth + session-sync + RBAC + tickets BOLA/RBAC API checks. Set baseUrl to your API origin (local: http://localhost:4000). Run with: pnpm test:auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "globexOrgId", "value": "" },
    { "key": "acmeOrgId", "value": "" },
    { "key": "globexTicketId", "value": "" },
    { "key": "acmeTicketId", "value": "" },
    { "key": "bobTicketId", "value": "" },
    { "key": "daveTicketId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('health ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login Dave",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"dave@example.com\",\"password\":\"password123\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('login 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "3. GET /auth/me (Dave) — save Globex orgId",
      "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('me 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const globex = body.memberships.find(m => m.orgSlug === 'globex');",
              "pm.collectionVariables.set('globexOrgId', globex.orgId);",
              "pm.test('globexOrgId saved', () => pm.expect(globex.orgId).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
