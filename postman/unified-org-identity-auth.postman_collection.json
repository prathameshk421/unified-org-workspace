        {
          "name": "38. GET /tickets (Carol) — save globexTicketId",
          "request": { "method": "GET", "url": "{{baseUrl}}/tickets" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('tickets 200', () => pm.response.to.have.status(200));",
            "const tickets = pm.response.json().tickets || [];",
            "const vpn = tickets.find(t => t.title === 'VPN access');",
            "const chosen = vpn || tickets[0];",
            "pm.test('globex ticket present', () => pm.expect(chosen).to.be.an('object'));",
            "pm.collectionVariables.set('globexTicketId', chosen.id);",
            "pm.test('globexTicketId saved', () => pm.expect(chosen.id).to.be.a('string').and.not.empty);"
          ] } }]
        },
        {
          "name": "39. Login Alice (Acme)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"alice@acme.com\",\"password\":\"password123\"}" },
