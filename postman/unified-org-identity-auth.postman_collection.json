              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('org 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('acmeOrgId', body.orgId);",
                  "pm.test('role ORG_ADMIN', () => pm.expect(body.role).to.eql('ORG_ADMIN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "21. GET /rbac/org ignores client orgId query",
          "request": { "method": "GET", "url": "{{baseUrl}}/rbac/org?orgId={{globexOrgId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('org 200', () => pm.response.to.have.status(200));",
                  "pm.test('orgId from session not query', () => {",
                  "  pm.expect(pm.response.json().orgId).to.eql(pm.collectionVariables.get('acmeOrgId'));",
                  "});"
                ]
              }
            }
          ]
