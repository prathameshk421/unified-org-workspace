# Copy to terraform.tfvars before `terraform apply`.
# Do not commit terraform.tfvars.

project_id  = "unified-org-workspace"
region      = "us-central1"
github_repo = "prathameshk421/unified-org-workspace"

# Default: use Cloud Run *.run.app URLs (no custom domain needed for the assignment).
enable_custom_domain = false

# Only required when enable_custom_domain = true:
# domain = "yourdomain.com"

# Optional cost controls
# db_tier         = "db-f1-micro"
# redis_memory_gb = 1

# AI Progress Tracker (digest Cloud Run Job + Cloud Scheduler 06:00 UTC)
# digest_enabled = true
# groq_api_key   = "gsk_..."   # Secret Manager GROQ_API_KEY; leave unset for template-only digests

# Argus digest email (Gmail SMTP) — mounted on digest job only; email stays off until enabled
# digest_email_enabled   = false
# smtp_user              = "argus.unified.workspace@gmail.com"
# smtp_pass              = "xxxx xxxx xxxx xxxx"  # Gmail App Password; leave unset until ready
# digest_email_allowlist = "your-alt@whatever.com"  # optional soft-launch allowlist
# Never set DIGEST_EMAIL_REDIRECT_TO in prod terraform.
