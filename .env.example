# Database (owner/superuser — used for migrations and seed)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unified_org"

# Database (app role — used at API runtime; INSERT-only on audit_logs)
DATABASE_APP_URL="postgresql://unified_app:unified_app@localhost:5432/unified_org"

# Redis
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Support Hub (Dashboard 1)
SUPPORT_HUB_PORT=3000
NEXT_PUBLIC_SUPPORT_HUB_URL="http://localhost:3000"

# Review & Audit Console (Dashboard 2)
REVIEW_CONSOLE_PORT=3001
NEXT_PUBLIC_REVIEW_CONSOLE_URL="http://localhost:3001"

# Shared parent domain (for session sync across dashboards in production)
# Omit locally (host-only cookies on API). Set in prod, e.g. .example.com
# COOKIE_DOMAIN=".example.com"

# Auth cookies (feat/identity-auth)
ACCESS_COOKIE_NAME="unified_access"
REFRESH_COOKIE_NAME="unified_refresh"
# COOKIE_SECURE=true  # force Secure cookies (auto true when NODE_ENV=production)
# SameSite matrix (set in code): Domain set → strict; secure+no domain → none (*.run.app); else strict

# CORS origins for credentialed requests (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Auth
JWT_SECRET="dev-only-secret-min-32-chars-long!!"
