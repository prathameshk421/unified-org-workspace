# Database (owner/superuser — used for migrations and seed)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unified_org"

# Database (app role — used at API runtime; INSERT-only on audit_logs)
DATABASE_APP_URL="postgresql://unified_app:unified_app@localhost:5432/unified_org"

# API
API_PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Support Hub (Dashboard 1)
SUPPORT_HUB_PORT=3000
NEXT_PUBLIC_SUPPORT_HUB_URL="http://localhost:3000"

# Review & Audit Console (Dashboard 2)
REVIEW_CONSOLE_PORT=3001
NEXT_PUBLIC_REVIEW_CONSOLE_URL="http://localhost:3001"

# Shared parent domain (for session sync across dashboards in production)
# Omit locally (host-only cookies on API). Set in prod, e.g. .example.com
# COOKIE_DOMAIN=".example.com"

# Auth cookies (feat/identity-auth)
ACCESS_COOKIE_NAME="unified_access"
REFRESH_COOKIE_NAME="unified_refresh"
# COOKIE_SECURE=true  # force Secure cookies (auto true when NODE_ENV=production)
# SameSite matrix (set in code): Domain set → strict; secure+no domain → none (*.run.app); else strict

# CORS origins for credentialed requests (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Auth
JWT_SECRET="dev-only-secret-min-32-chars-long!!"

# AI Progress Tracker (digest worker — not used by `pnpm dev` / API request path)
# DIGEST_ENABLED=true                    # required to process users (default false)
# DIGEST_LLM_ENABLED=true                # default: true when GROQ_API_KEY is set
# GROQ_API_KEY="gsk_..."                 # optional; template fallback without it
# GROQ_MODEL="openai/gpt-oss-20b"
# DIGEST_TICKET_STALE_DAYS=3
# DIGEST_PR_IDLE_DAYS=3
# DIGEST_LLM_TIMEOUT_MS=8000
# DIGEST_MAX_USERS_PER_RUN=10000
# DIGEST_STALE_RUNNING_MS=600000         # resume stale RUNNING claims after this many ms
# Run once: DIGEST_ENABLED=true pnpm --filter @unified/api digest:once

# Argus email digest (optional; digest worker only — default OFF)
# Brand: Argus | sender: argus.unified.workspace@gmail.com
# DIGEST_EMAIL_ENABLED=false             # master switch (default false)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=argus.unified.workspace@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx          # Gmail App Password labeled "Argus" (not normal password)
# SMTP_FROM=Argus <argus.unified.workspace@gmail.com>
# SEED_ARGUS_TEST_EMAIL=you@gmail.com     # optional private Argus tester (not in public demo creds)
# SEED_MIGRATE_DAVE_FROM=you@gmail.com     # one-shot: rename that email → dave@example.com if Dave missing
# DIGEST_EMAIL_ALLOWLIST=you@gmail.com     # soft rollout — match SEED_ARGUS_TEST_EMAIL; omit for Froncort
# DIGEST_EMAIL_REDIRECT_TO=               # LOCAL/TEST ONLY — never set in production

# Attachment storage (local default: filesystem; Cloud Run: GCS via Terraform)
# ATTACHMENTS_DIR="./data/attachments"
# ATTACHMENTS_BACKEND=fs
# Production (set by Terraform on the API Cloud Run service):
# ATTACHMENTS_BACKEND=gcs
# ATTACHMENTS_GCS_BUCKET=unified-org-attachments-<project-id>

# Optional: raise for local Playwright/Newman suites (default API limit is 10/min per email)
# AUTH_RATE_LIMIT_MAX=1000
